{
  "name": "wespr",
  "productName": "WeSpR",
  "version": "1.0.0",
  "description": "Local audio & video transcription for macOS — powered by whisper.cpp",
  "main": "dist-electron/main.js",
  "author": "WeSpR Contributors",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:app\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron -- --watch",
    "dev:app": "wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:electron && vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --outdir=dist-electron --external:electron --external:electron-store --external:fs-extra --external:axios",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/postinstall.js",
    "setup:binaries": "WESPR_SETUP_BINARIES=1 node scripts/postinstall.js"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "framer-motion": "^12.12.1",
    "fs-extra": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "wait-on": "^8.0.3"
  }
}
